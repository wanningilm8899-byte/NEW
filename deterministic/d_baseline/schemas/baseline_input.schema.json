                        },
                        "proxy_value": {
                          "type": "number",
                          "description": "批准代理值，仅当 approved_proxy=true 时允许使用"
                        }
                      },
                      "additionalProperties": false
                    },
                    "DYS": {
                      "type": "object",
                      "properties": {
                        "source_ref": {
                          "type": "string",
                          "description": "来源引用（数据版本/文献/规则编号）"
                        },
                        "data_status": {
                          "type": "string",
                          "enum": [
                            "V",
