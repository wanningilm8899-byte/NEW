{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BaselineInput",
  "description": "路径匹配型水风险基准评估——统一输入 Schema（engine v1.2）。所有字段单位与粒度以本 Schema 为准。",
  "version": "schema-1.0 / 2026-09-09",
  "type": "object",
  "required": [
    "run_id",
    "enterprise_id",
    "materials"
  ],
  "additionalProperties": true,
  "properties": {
    "run_id": {
      "type": "string",
      "description": "运行级唯一标识，用于追踪"
    },
    "enterprise_id": {
      "type": "string"
    },
    "data_version": {
      "type": "string",
      "description": "数据层版本号，用于复现"
    },
    "theta": {
      "type": "object",
      "description": "路径权重，缺省 1/3,1/3,1/3；三项之和必须=1（容差1e-3）",
      "properties": {
        "WS": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "DR": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "SV": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "material",
          "U",
          "nodes"
        ],
        "properties": {
          "material": {
            "type": "string",
            "description": "材料名称或编码"
          },
          "U": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "未知/未映射采购份额；ΣW+U 必须=1，不得静默归一化"
          },
          "material_params": {
            "type": "object",
            "description": "材料级参数（节点缺省时按 BWD→OA→DYS→CTS 顺序回退，回退事实在输出中标注）",
            "properties": {
              "BWD": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "DYS": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100,
                "description": "最大100：当 DYS_unit=loss_percent 时按冻结规则映射"
              },
              "DYS_unit": {
                "type": "string",
                "enum": [
                  "score_0_1",
                  "loss_percent"
                ],
                "default": "score_0_1"
              },
              "CTS": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "OA": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "node_id",
                "W",
                "WS",
                "SV",
                "DR"
              ],
              "properties": {
                "node_id": {
                  "type": "string",
                  "description": "节点唯一主键，建议与 material 联合唯一"
                },
                "node_name": {
                  "type": "string"
                },
                "spatial_level": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "basin": {
                  "type": "string"
                },
                "pfaf_id": {
                  "type": "string"
                },
                "reference_period": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "W": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "conflict",
                        "candidates"
                      ],
                      "properties": {
                        "conflict": {
                          "const": true
                        },
                        "candidates": {
                          "type": "array"
                        },
                        "note": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ],
                  "description": "采购权重 0-1；0=对照节点不参与求和；可为冲突对象"
                },
                "WS": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "conflict",
                        "candidates"
                      ],
                      "properties": {
                        "conflict": {
                          "const": true
                        },
                        "candidates": {
                          "type": "array"
                        },
                        "note": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ],
                  "description": "水压力【关键字段】"
                },
                "WS_unit": {
                  "type": "string",
                  "enum": [
                    "normalized_0_1",
                    "aqueduct_score_0_5"
                  ],
                  "default": "normalized_0_1",
                  "description": "aqueduct_score_0_5 时程序内部除以5标准化，同时保留原始值"
                },
                "SV": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "conflict",
                        "candidates"
                      ],
                      "properties": {
                        "conflict": {
                          "const": true
                        },
                        "candidates": {
                          "type": "array"
                        },
                        "note": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ],
                  "description": "季节波动【关键字段】"
                },
                "SV_unit": {
                  "type": "string",
                  "enum": [
                    "normalized_0_1",
                    "aqueduct_score_0_5"
                  ],
                  "default": "normalized_0_1"
                },
                "DR": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "conflict",
                        "candidates"
                      ],
                      "properties": {
                        "conflict": {
                          "const": true
                        },
                        "candidates": {
                          "type": "array"
                        },
                        "note": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  ],
                  "description": "历史干旱负担 0-1【关键字段】"
                },
                "BWD": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "蓝水依赖；节点级优先，缺省回退 material_params.BWD"
                },
                "DYS": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "干旱产出敏感性；DYS_unit=loss_percent 时按冻结映射规则转换"
                },
                "DYS_unit": {
                  "type": "string",
                  "enum": [
                    "score_0_1",
                    "loss_percent"
                  ],
                  "default": "score_0_1"
                },
                "CTS": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "OA": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "关键期-高压力月份重合度；缺失不得静默设为1"
                },
                "field_meta": {
                  "type": "object",
                  "description": "逐字段元数据：来源、身份(V/P/A/S)、置信度、批准代理",
                  "properties": {
                    "W": {
                      "type": "object",
                      "properties": {
                        "source_ref": {
                          "type": "string",
                          "description": "来源引用（数据版本/文献/规则编号）"
                        },
                        "data_status": {
                          "type": "string",
                          "enum": [
                            "V",
                            "P",
                            "A",
                            "S"
                          ]
                        },
                        "confidence": {
                          "type": "string",
                          "enum": [
                            "High",
                            "Medium",
                            "Low"
                          ]
                        },
                        "approved_proxy": {
                          "type": "boolean",
                          "description": "是否为项目已批准的代理规则"
                        },
                        "proxy_value": {
                          "type": "number",
                          "description": "批准代理值，仅当 approved_proxy=true 时允许使用"
                        }
                      },
                      "additionalProperties": false
                    },
                    "WS": {
                      "type": "object",
                      "properties": {
                        "source_ref": {
                          "type": "string",
                          "description": "来源引用（数据版本/文献/规则编号）"
                        },
                        "data_status": {
                          "type": "string",
