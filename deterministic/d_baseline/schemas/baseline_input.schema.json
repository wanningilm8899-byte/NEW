                        }
                      },
                      "additionalProperties": false
                    },
                    "SV": {
                      "type": "object",
                      "properties": {
                        "source_ref": {
                          "type": "string",
                          "description": "来源引用（数据版本/文献/规则编号）"
                        },
                        "data_status": {
                          "type": "string",
