                        },
                        "proxy_value": {
                          "type": "number",
                          "description": "批准代理值，仅当 approved_proxy=true 时允许使用"
                        }
                      },
                      "additionalProperties": false
                    },
                    "DR": {
                      "type": "object",
                      "properties": {
